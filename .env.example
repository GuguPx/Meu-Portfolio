# Copie este arquivo para ".env" e preencha os valores.

# Chave de acesso do Web3Forms (https://web3forms.com — grátis, sem backend).
# Sem ela, o formulário de contato usa o fallback via mailto.
VITE_WEB3FORMS_KEY=

# URL pública do site após o deploy (opcional).
VITE_SITE_URL=https://augusto-silva.vercel.app
